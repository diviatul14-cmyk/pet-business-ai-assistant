@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap");

:root {
  --green: #07513d;
  --green-dark: #043b2d;
  --green-soft: #e8f2e6;
  --gold: #b38a32;
  --cream: #f5f4ed;
  --white: #ffffff;
  --text: #244f42;
  --muted: #728078;
  --border: rgba(18, 76, 57, 0.1);
  --shadow: 0 10px 30px rgba(6, 60, 43, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  padding: 0;
  color: var(--text);
  font-family: "DM Sans", Arial, sans-serif;
  background:
    linear-gradient(
      rgba(246, 245, 238, 0.86),
      rgba(246, 245, 238, 0.94)
    ),
    url("https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=2200&q=80")
      center / cover fixed;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  display: block;
  max-width: 100%;
}

.petora-site {
  min-height: 100vh;
  overflow-x: hidden;
}

section {
  scroll-margin-top: 90px;
}

.eyebrow {
  display: inline-block;
  color: var(--gold);
  font-size: 9px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

/* =========================================
   TOP STRIP
========================================= */

.top-strip {
  min-height: 30px;
  padding: 6px 4vw;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--green-dark);
  color: rgba(255, 255, 255, 0.82);
  font-size: 10px;
  font-weight: 600;
}

/* =========================================
   HEADER
========================================= */

.site-header {
  width: calc(100% - 40px);
  max-width: 1440px;
  min-height: 68px;
  margin: 14px auto 0;
  padding: 10px 18px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 18px;
  background: rgba(255, 255, 255, 0.97);
  border: 1px solid rgba(255, 255, 255, 0.95);
  border-radius: 18px;
  box-shadow: 0 8px 25px rgba(15, 61, 47, 0.07);
  position: sticky;
  top: 10px;
  z-index: 100;
}

.header-brand {
  display: flex;
  align-items: center;
  gap: 9px;
}

.header-brand img {
  width: 54px;
  height: 36px;
  object-fit: contain;
}

.header-brand div {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.header-brand strong {
  color: var(--green);
  font-size: 14px;
  line-height: 1.1;
}

.header-brand span {
  color: #89928d;
  font-size: 8px;
}

.main-nav {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 2px;
}

.main-nav button {
  border: 0;
  background: transparent;
  color: var(--text);
  padding: 8px 11px;
  border-radius: 9px;
  font-size: 11px;
  font-weight: 600;
}

.main-nav button:hover {
  background: var(--green-soft);
}

.header-ai-button {
  justify-self: end;
  padding: 9px 14px;
  border: 0;
  border-radius: 10px;
  background: var(--green);
  color: white;
  font-size: 10px;
  font-weight: 700;
}

/* =========================================
   HERO
========================================= */

.hero-section {
  width: calc(100% - 48px);
  max-width: 1440px;
  min-height: 420px;
  margin: 22px auto 0;
  padding: 42px 52px;
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 34px;
  align-items: center;
  background:
    linear-gradient(
      110deg,
      rgba(242, 247, 237, 0.96),
      rgba(236, 245, 233, 0.87)
    );
  border: 1px solid rgba(45, 90, 69, 0.08);
  border-radius: 26px;
  box-shadow: var(--shadow);
}

.hero-copy {
  max-width: 600px;
}

.hero-copy h1 {
  margin: 11px 0 16px;
  color: var(--green);
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(42px, 4.4vw, 66px);
  line-height: 0.98;
  letter-spacing: -0.035em;
}

.hero-copy p {
  max-width: 560px;
  margin: 0;
  color: #6e7b74;
  font-size: 13px;
  line-height: 1.65;
}

.hero-actions {
  margin-top: 21px;
  display: flex;
  gap: 9px;
}

.primary-button,
.secondary-button {
  padding: 10px 14px;
  border-radius: 10px;
  font-size: 10px;
  font-weight: 700;
}

.primary-button {
  border: 1px solid var(--green);
  background: var(--green);
  color: white;
}

.secondary-button {
  border: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.85);
  color: var(--green);
}

.hero-points {
  margin-top: 16px;
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.hero-points span {
  padding: 7px 9px;
  border: 1px solid rgba(18, 76, 57, 0.08);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.7);
  color: #63736b;
  font-size: 9px;
  font-weight: 600;
}

.hero-visual {
  min-height: 310px;
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;
  border-radius: 22px;
  background:
    radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.97),
      rgba(240, 244, 234, 0.84)
    );
}

.hero-logo {
  width: min(76%, 440px);
  object-fit: contain;
  filter: drop-shadow(
    0 12px 22px rgba(0, 55, 40, 0.1)
  );
}

.hero-caption {
  position: absolute;
  left: 15px;
  bottom: 15px;
  padding: 9px 11px;
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 10px;
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.06);
}

.hero-caption strong {
  color: var(--green);
  font-size: 9px;
}

.hero-caption span {
  color: #77837d;
  font-size: 8px;
}

/* =========================================
   CATEGORY
========================================= */

.category-section {
  width: calc(100% - 48px);
  max-width: 1440px;
  margin: 38px auto 0;
}

.section-heading {
  margin-bottom: 14px;
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
}

.section-heading h2,
.marketplace-heading h2,
.contact-heading h2,
.about-copy h2 {
  margin: 8px 0 0;
  color: var(--green);
  font-family: "Playfair Display", Georgia, serif;
  font-size: clamp(31px, 3.2vw, 47px);
  line-height: 1.02;
  letter-spacing: -0.035em;
}

.section-heading > p {
  max-width: 300px;
  margin: 0;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.6;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10px;
}

.category-card {
  position: relative;
  min-height: 148px;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: 17px;
  background: #163d30;
  text-align: left;
}

.category-card img {
  width: 100%;
  height: 148px;
  object-fit: cover;
  transition: transform 0.35s ease;
}

.category-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      to top,
      rgba(0, 39, 28, 0.82),
      rgba(0, 39, 28, 0.02) 62%
    );
}

.category-card:hover img {
  transform: scale(1.04);
}

.category-overlay {
  position: absolute;
  left: 12px;
  bottom: 12px;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.category-overlay strong {
  color: #fff;
  font-size: 13px;
}

.category-overlay span {
  color: rgba(255, 255, 255, 0.75);
  font-size: 8px;
}

.category-arrow {
  position: absolute;
  right: 12px;
  bottom: 11px;
  z-index: 3;
  color: white;
  font-size: 16px;
}

/* =========================================
   MARKETPLACE
========================================= */

.marketplace-section {
  width: calc(100% - 48px);
  max-width: 1440px;
  margin: 44px auto 0;
}

.marketplace-heading {
  margin-bottom: 16px;
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 15px;
}

.marketplace-heading p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 10px;
}

.availability-badge {
  padding: 8px 11px;
  border-radius: 999px;
  background: #e4f1e2;
  color: var(--green);
  font-size: 9px;
  font-weight: 800;
}

.marketplace-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.75fr) minmax(300px, 0.75fr);
  gap: 16px;
  align-items: start;
}

.marketplace-main {
  min-width: 0;
}

.search-box {
  min-height: 48px;
  padding: 5px 6px 5px 13px;
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.97);
  border: 1px solid var(--border);
  border-radius: 12px;
}

.search-box > span {
  color: #89958f;
  font-size: 14px;
}

.search-box input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  font-size: 10px;
}

.search-box input::placeholder {
  color: #a1aaa4;
}

.search-box button {
  border: 0;
  padding: 8px 10px;
  border-radius: 8px;
  background: var(--green);
  color: white;
  font-size: 9px;
  font-weight: 700;
}

.filter-row {
  margin: 9px 0;
  display: flex;
  gap: 6px;
}

.filter-button {
  border: 1px solid rgba(18, 76, 57, 0.09);
  padding: 7px 11px;
  border-radius: 999px;
  background: white;
  color: var(--green);
  font-size: 9px;
  font-weight: 700;
}

.filter-button.active {
  border-color: var(--green);
  background: var(--green);
  color: white;
}

.pet-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 11px;
}

.pet-card {
  overflow: hidden;
  background: white;
  border: 1px solid rgba(18, 76, 57, 0.08);
  border-radius: 17px;
  box-shadow: 0 8px 22px rgba(8, 61, 45, 0.07);
}

.pet-image-wrap {
  height: 205px;
  position: relative;
  overflow: hidden;
  background: #edf4ea;
}

.pet-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
}

.pet-card:hover .pet-image {
  transform: scale(1.035);
}

.pet-status {
  position: absolute;
  top: 10px;
  right: 10px;
  padding: 6px 8px;
  border-radius: 999px;
  background: rgba(243, 250, 241, 0.95);
  color: var(--green);
  font-size: 8px;
  font-weight: 800;
}

.pet-card-body {
  padding: 14px;
}

.pet-category {
  color: var(--gold);
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.pet-card h3 {
  margin: 5px 0 2px;
  color: var(--green);
  font-family: "Playfair Display", Georgia, serif;
  font-size: 21px;
  line-height: 1;
}

.pet-name {
  margin: 0;
  color: #819089;
  font-size: 9px;
}

.pet-details {
  margin-top: 11px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.pet-details span {
  display: flex;
  flex-direction: column;
  gap: 2px;
  color: #68776f;
  font-size: 8px;
}

.pet-details b {
  color: #4c6259;
  font-size: 7px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.pet-card-footer {
  margin-top: 13px;
  padding-top: 11px;
  border-top: 1px solid rgba(18, 76, 57, 0.07);
}

.pet-card-footer > div {
  display: flex;
  flex-direction: column;
}

.pet-card-footer small {
  color: #929c97;
  font-size: 7px;
}

.pet-card-footer strong {
  margin-top: 2px;
  color: var(--green);
  font-size: 19px;
}

.interest-button {
  width: 100%;
  margin-top: 10px;
  padding: 9px 10px;
  border: 1px solid var(--green);
  border-radius: 9px;
  background: var(--green);
  color: white;
  font-size: 9px;
  font-weight: 700;
}

.inventory-state {
  min-height: 250px;
  padding: 32px 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
  background: rgba(255, 255, 255, 0.97);
  border: 1px solid var(--border);
  border-radius: 17px;
}

.inventory-state h3 {
  margin: 10px 0 3px;
  color: var(--green);
  font-size: 18px;
}

.inventory-state p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
}

.loading-spinner {
  width: 29px;
  height: 29px;
  border: 3px solid #dfe9df;
  border-top-color: var(--green);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.empty-paw {
  position: relative;
  width: 48px;
  height: 44px;
}

.empty-paw::before {
  content: "";
  position: absolute;
  left: 14px;
  bottom: 2px;
  width: 22px;
  height: 19px;
  border-radius: 48% 52% 45% 55%;
  background: #555b57;
}

.empty-paw span {
  position: absolute;
  width: 9px;
  height: 11px;
  border-radius: 50%;
  background: #555b57;
}

.empty-paw span:nth-child(1) {
  left: 12px;
  top: 7px;
  transform: rotate(-22deg);
}

.empty-paw span:nth-child(2) {
  left: 27px;
  top: 4px;
  transform: rotate(18deg);
}

/* =========================================
   AI PANEL
========================================= */

.ai-panel {
  overflow: hidden;
  position: sticky;
  top: 94px;
  background:
    linear-gradient(
      150deg,
      #064b37,
      #053f30
    );
  border-radius: 18px;
  box-shadow: 0 12px 32px rgba(3, 57, 41, 0.14);
}

.ai-header {
  padding: 13px;
  display: flex;
  align-items: center;
  gap: 9px;
  background: rgba(255, 255, 255, 0.97);
}

.ai-avatar {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #e3f1df;
  color: var(--green);
  font-size: 13px;
}

.ai-header div:last-child {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.ai-header strong {
  color: var(--green);
  font-size: 11px;
}

.ai-header span {
  color: #87918d;
  font-size: 7px;
}

.ai-conversation {
  min-height: 330px;
  max-height: 470px;
  overflow-y: auto;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ai-user-message,
.ai-message {
  max-width: 91%;
  padding: 10px 11px;
  border-radius: 12px;
  font-size: 9px;
  line-height: 1.55;
}

.ai-user-message {
  align-self: flex-end;
  background: #e1efdb;
  color: var(--green);
}

.ai-message {
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.09);
  color: rgba(255, 255, 255, 0.9);
}

.ai-input-row {
  margin: 0 10px 10px;
  min-height: 40px;
  display: flex;
  align-items: center;
  background: white;
  border-radius: 10px;
  overflow: hidden;
}

.ai-input-row input {
  flex: 1;
  min-width: 0;
  padding: 10px;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  font-size: 9px;
}

.ai-input-row button {
  width: 29px;
  height: 29px;
  margin-right: 5px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 8px;
  background: var(--green);
  color: white;
}

/* =========================================
   TRUST
========================================= */

.trust-strip {
  width: calc(100% - 48px);
  max-width: 1440px;
  margin: 28px auto 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  overflow: hidden;
  background: white;
  border: 1px solid var(--border);
  border-radius: 17px;
}

.trust-strip > div {
  min-height: 66px;
  padding: 13px 16px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-right: 1px solid rgba(18, 76, 57, 0.07);
}

.trust-strip > div:last-child {
  border-right: 0;
}

.trust-strip strong {
  color: var(--green);
  font-size: 9px;
}

.trust-strip span {
  margin-top: 3px;
  color: var(--muted);
  font-size: 7px;
}

/* =========================================
   ABOUT
========================================= */

.about-section {
  width: calc(100% - 48px);
  max-width: 1440px;
  margin: 40px auto 0;
  display: grid;
  grid-template-columns: 1fr 0.85fr;
  gap: 28px;
  align-items: center;
}

.about-copy p {
  max-width: 580px;
  margin: 15px 0 0;
  color: #717f78;
  font-size: 11px;
  line-height: 1.7;
}

.about-points {
  margin-top: 15px;
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.about-points span {
  padding: 7px 9px;
  border-radius: 999px;
  background: #edf5ea;
  color: var(--green);
  font-size: 8px;
  font-weight: 700;
}

.about-brand-card {
  min-height: 280px;
  padding: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 14px;
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: var(--shadow);
}

.about-brand-card img {
  width: min(75%, 360px);
  max-height: 180px;
  object-fit: contain;
}

.about-brand-card strong {
  color: var(--green);
  font-family: "Playfair Display", Georgia, serif;
  font-size: 17px;
  text-align: center;
}

/* =========================================
   CONTACT
========================================= */

.contact-section {
  width: calc(100% - 48px);
  max-width: 1440px;
  margin: 42px auto 0;
  padding: 30px;
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid var(--border);
  border-radius: 22px;
  box-shadow: var(--shadow);
}

.contact-heading {
  margin-bottom: 20px;
}

.contact-heading > p {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 10px;
}

.selected-pet {
  width: fit-content;
  margin-top: 12px;
  padding: 8px 10px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  border-radius: 9px;
  background: var(--green-soft);
}

.selected-pet span {
  color: var(--muted);
  font-size: 7px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.selected-pet strong {
  color: var(--green);
  font-size: 9px;
}

.contact-layout {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 16px;
}

.enquiry-form {
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: #f7f8f3;
  border: 1px solid rgba(18, 76, 57, 0.06);
  border-radius: 15px;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.enquiry-form label {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.enquiry-form label > span {
  color: var(--green);
  font-size: 7px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.enquiry-form input,
.enquiry-form textarea,
.enquiry-form select {
  width: 100%;
  padding: 10px 11px;
  border: 1px solid rgba(18, 76, 57, 0.1);
  border-radius: 9px;
  outline: 0;
  background: white;
  color: var(--text);
  font-size: 9px;
}

.enquiry-form textarea {
  resize: vertical;
}

.form-submit {
  width: fit-content;
}

.form-submit:disabled {
  opacity: 0.6;
}

.form-note {
  color: #8b958f;
  font-size: 7px;
}

.form-message {
  padding: 8px 10px;
  border-radius: 8px;
  background: #e9f3e5;
  color: var(--green);
  font-size: 8px;
}

.contact-info-card {
  min-height: 100%;
  padding: 20px;
  display: flex;
  flex-direction: column;
  border-radius: 15px;
  background:
    linear-gradient(
      145deg,
      #07503b,
      #043b2d
    );
  color: white;
}

.contact-info-card h3 {
  margin: 7px 0 3px;
  font-family: "Playfair Display", Georgia, serif;
  font-size: 28px;
}

.contact-info-card p {
  margin: 0;
  color: rgba(255, 255, 255, 0.68);
  font-size: 9px;
}

.contact-lines {
  margin-top: 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.contact-lines span {
  color: rgba(255, 255, 255, 0.84);
  font-size: 9px;
}

.contact-brand {
  margin-top: auto;
  padding-top: 22px;
}

.contact-brand img {
  width: 135px;
  padding: 8px;
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.96);
}

/* =========================================
   FOOTER
========================================= */

.site-footer {
  width: calc(100% - 28px);
  max-width: 1440px;
  margin: 28px auto 14px;
  padding: 26px 28px 15px;
  background:
    linear-gradient(
      135deg,
      #064d39,
      #033426
    );
  color: white;
  border-radius: 20px;
}

.footer-main {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 24px;
}

.footer-brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.footer-brand strong {
  font-size: 20px;
}

.footer-brand span {
  margin-top: 3px;
  color: #ddbd5b;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.16em;
}

.footer-brand p {
  margin: 16px 0 0;
  color: rgba(255, 255, 255, 0.84);
  font-family: "Playfair Display", Georgia, serif;
  font-size: 15px;
}

.footer-column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
}

.footer-column > strong {
  margin-bottom: 3px;
  color: #dfbf5b;
  font-size: 8px;
  letter-spacing: 0.14em;
}

.footer-column button,
.footer-column span {
  padding: 0;
  border: 0;
  background: transparent;
  color: rgba(255, 255, 255, 0.67);
  font-size: 8px;
  text-align: left;
}

.footer-column button:hover {
  color: white;
}

.footer-bottom {
  margin-top: 22px;
  padding-top: 11px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.42);
  font-size: 7px;
}

/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 1100px) {
  .site-header {
    grid-template-columns: 1fr auto;
  }

  .main-nav {
    grid-column: 1 / -1;
    justify-content: flex-start;
    overflow-x: auto;
  }

  .header-ai-button {
    grid-column: 2;
    grid-row: 1;
  }

  .category-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .marketplace-layout {
    grid-template-columns: 1fr;
  }

  .ai-panel {
    position: relative;
    top: auto;
  }
}

@media (max-width: 850px) {
  .hero-section {
    grid-template-columns: 1fr;
    padding: 32px;
  }

  .hero-visual {
    min-height: 270px;
  }

  .pet-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about-section,
  .contact-layout {
    grid-template-columns: 1fr;
  }

  .trust-strip {
    grid-template-columns: repeat(2, 1fr);
  }

  .trust-strip > div:nth-child(2) {
    border-right: 0;
  }

  .footer-main {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .site-header {
    width: calc(100% - 18px);
    padding: 9px 11px;
    border-radius: 14px;
  }

  .main-nav button {
    padding: 7px 8px;
    font-size: 9px;
  }

  .hero-section,
  .category-section,
  .marketplace-section,
  .about-section,
  .trust-strip,
  .contact-section {
    width: calc(100% - 18px);
  }

  .hero-section {
    padding: 26px 19px;
    border-radius: 20px;
  }

  .hero-copy h1 {
    font-size: 42px;
  }

  .category-grid {
    grid-template-columns: 1fr 1fr;
  }

  .pet-grid {
    grid-template-columns: 1fr;
  }

  .pet-image-wrap {
    height: 275px;
  }

  .trust-strip {
    grid-template-columns: 1fr;
  }

  .trust-strip > div {
    border-right: 0;
    border-bottom: 1px solid rgba(18, 76, 57, 0.07);
  }

  .trust-strip > div:last-child {
    border-bottom: 0;
  }

  .contact-section {
    padding: 20px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .footer-main {
    grid-template-columns: 1fr;
  }

  .footer-bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}