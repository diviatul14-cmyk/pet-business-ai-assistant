import type { Metadata } from "next";
import Link from "next/link";

type Pet = {
  id?: string;
  puppy_id?: string;
  category?: string;
  species?: string;
  breed?: string;
  name?: string;
  gender?: string;
  age?: string;
  age_weeks?: string | number;
  price?: string | number;
  status?: string;
  vaccinated?: string;
  location?: string;
  image?: string;
  photo?: string;
  description?: string;
};

const SITE_URL = "https://petora-ashen.vercel.app";

async function getPets(): Promise<Pet[]> {
  const response = await fetch(`${SITE_URL}/api/pets`, {
    cache: "no-store",
  });

  if (!response.ok) {
    throw new Error("Unable to load PETORA inventory");
  }

  return response.json();
}

async function getPet(id: string) {
  const pets = await getPets();

  return pets.find(
    (pet) =>
      String(pet.id || pet.puppy_id || "").toLowerCase() === id.toLowerCase()
  );
}

export async function generateMetadata({
  params,
}: {
  params: Promise<{ id: string }>;
}): Promise<Metadata> {
  const { id } = await params;
  const pet = await getPet(id);

  if (!pet) {
    return {
      title: "Pet Not Found | PETORA™",
      description: "This PETORA pet listing could not be found.",
    };
  }

  const name = pet.name || pet.breed || "Pet";
  const breed = pet.breed || pet.species || "Pet";
  const location = pet.location || "India";

  return {
    title: `${name} - ${breed} | PETORA™`,
    description: `View the PETORA listing for ${name}, ${breed} in ${location}. Check availability, age, vaccination information, price and enquiry options.`,
    alternates: {
      canonical: `/pets/${encodeURIComponent(
        String(pet.id || pet.puppy_id || id)
      )}`,
    },
    openGraph: {
      title: `${name} - ${breed} | PETORA™`,
      description: `Explore the ${name} ${breed} listing on PETORA™.`,
      url: `${SITE_URL}/pets/${encodeURIComponent(
        String(pet.id || pet.puppy_id || id)
      )}`,
      siteName: "PETORA™",
      type: "website",
      images: pet.image
        ? [
            {
              url: pet.image.startsWith("http")
                ? pet.image
                : `${SITE_URL}${pet.image.startsWith("/") ? "" : "/"}${pet.image}`,
              alt: `${name} - ${breed}`,
            },
          ]
        : undefined,
    },
  };
}

